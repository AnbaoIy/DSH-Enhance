{
  "name": "dsh-enhance",
  "version": "1.2.0",
  "description": "DSH-Enhance: 会话迁移（含备份与迁移记录恢复）/ 删除增强，以及多平台优先-候补的搜索与抓取替换。",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AnbaoIy/DSH-Enhance.git"
  },
  "homepage": "https://github.com/AnbaoIy/DSH-Enhance#readme",
  "bugs": {
    "url": "https://github.com/AnbaoIy/DSH-Enhance/issues"
  },
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "deepseek",
    "harness",
    "dsh",
    "dsh-plugin",
    "workspace",
    "session",
    "delete-session",
    "web-search",
    "web-fetch"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-credentials": "*",
    "@deepseek-ai/dsh-launch-environment": "*",
    "@deepseek-ai/dsh-web": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-credentials": {
      "optional": true
    },
    "@deepseek-ai/dsh-launch-environment": {
      "optional": true
    },
    "@deepseek-ai/dsh-web": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "scripts": {
    "test": "node --test --test-isolation=none --import ./test/register-shims.mjs \"test/**/*.test.mjs\"",
    "prepublishOnly": "npm test"
  }
}
